# .env.example
# Copy to .env and fill in values before running in production.
# For local development the defaults in config.py are sufficient.

# Flask session secret — MUST be changed before deploying
SECRET_KEY=dev-secret-change-in-prod

# SQLAlchemy database URI
# Default: sqlite:///cctv.db (file in project root)
# Production example: postgresql://user:pass@localhost/cctv
DATABASE_URL=sqlite:///cctv.db

# Set to "1" only if all registered cameras should start on backend boot.
# Leave disabled for frontend-controlled camera ingestion.
AUTO_START_CAMERAS=0

# Optional live catalogue startup. When enabled, the catalogue supplies the
# camera IDs and stream URLs; DB rows remain the fallback if it is unavailable.
INGESTION_USE_CATALOGUE=0
CAMERA_CATALOGUE_HOST=cctv.corp8.cloud

# Sentinel Camera Grid Credentials (cctv.corp8.cloud) — PLACEHOLDERS ONLY
# DO NOT commit real credentials here. Put real values in your local .env file.
SENTINEL_EMAIL=user@example.com
SENTINEL_PASSWORD=your-secret-password-here

# Optional comma-separated allow-list to pace production load, e.g. 6,14,26.
# Leave empty to start every camera from the selected source.
INGESTION_CAMERA_IDS=

# ---------------------------------------------------------------------------
# WhatsApp alert agent  (real values go in .env only - never commit them)
# ---------------------------------------------------------------------------
ALERT_AGENT_ENABLED=1
# log = no network, writes demo_output/whatsapp_outbox.txt | webbridge | callmebot | twilio | meta
WHATSAPP_PROVIDER=log
# comma-separated, with country code
WHATSAPP_TO=+91XXXXXXXXXX
# Twilio (sandbox number shown below is Twilio's public sandbox sender)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WhatsApp Web bridge (start_whatsapp_bridge.bat, scan QR once)
WA_BRIDGE_URL=http://127.0.0.1:3005
WA_BRIDGE_TOKEN=
# CallMeBot: one apikey per number, same order as WHATSAPP_TO
CALLMEBOT_APIKEYS=
# Meta WhatsApp Cloud API (alternative to Twilio)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
# Optional backup channel - sent in addition to WhatsApp
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Agent tuning
ALERT_AGENT_DEDUPE_S=300
ALERT_AGENT_MAX_PER_MIN=10
CLONE_SPEED_KMH=150
DASHBOARD_PUBLIC_URL=
# Registry: sample (demo records) | vahan_http (authorised API) | none
RTO_PROVIDER=sample
RTO_API_URL=
RTO_API_KEY=
